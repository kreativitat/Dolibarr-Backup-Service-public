#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
python3 scripts/check_public_files.py
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "Install Gitleaks before pushing: https://github.com/gitleaks/gitleaks" >&2
    exit 1
fi
exec gitleaks git . --config .gitleaks.toml --log-opts="--all --full-history" \
    --gitleaks-ignore-path /dev/null --ignore-gitleaks-allow --redact=100 --no-banner
